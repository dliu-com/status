    {
      "key": "root",
      "name": "dliu.com",
      "url": "https://dliu.com/",
      "docs": "https://dliu.com/docs/health",
      "health": false,
      "functions": [
        {
          "key": "pages",
          "name": "Pages",
          "checks": [
            {
              "url": "https://dliu.com/",
              "expect": {
                "status": 200,
                "type": "text/html",
                "contains": "class=\"dl-header\""
              },
              "slowMs": 2000
            },
            {
              "url": "https://dliu.com/docs",
