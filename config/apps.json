{
  "intervalMinutes": 15,
  "defaults": {
    "timeoutMs": 10000,
    "slowMs": 3000,
    "failuresBeforeDown": 2
  },
  "apps": [
    {
      "key": "root",
      "name": "dliu.com",
      "url": "https://dliu.com/",
      "docs": "https://dliu.com/docs/health",
      "health": false,
      "functions": [
        {
          "key": "pages",
          "name": "Pages",
          "checks": [
            {
              "url": "https://dliu.com/",
              "expect": {
                "status": 200,
                "type": "text/html",
                "contains": "class=\"dl-header\""
              },
              "slowMs": 2000
            },
            {
              "url": "https://dliu.com/docs",
              "expect": {
                "status": 200,
                "type": "text/html",
                "contains": "dl-docs-main"
              },
              "slowMs": 2000
            },
            {
              "url": "https://dliu.com/style.css",
              "expect": {
                "status": 200,
                "type": "text/css",
                "contains": ".app-grid"
              },
              "slowMs": 2000
            },
            {
              "url": "https://dliu.com/docs/health.md",
              "expect": {
                "status": 200,
                "type": "text/markdown",
                "contains": "## Guest checks"
              },
              "slowMs": 2000
            }
          ]
        },
        {
          "key": "resume",
          "name": "Résumé",
          "critical": false,
          "checks": [
            {
              "url": "https://dliu.com/resume.pdf",
              "expect": {
                "status": 200,
                "type": "application/pdf",
                "contains": "%PDF-"
              },
              "slowMs": 3000
            }
          ]
        },
        {
          "key": "routing",
          "name": "Clean URLs and 404",
          "critical": false,
          "checks": [
            {
              "url": "https://dliu.com/docs/health",
              "expect": {
                "status": 200,
                "type": "text/html",
                "contains": "id=\"functions\""
              },
              "slowMs": 2000
            },
            {
              "url": "https://dliu.com/status-check-missing-page",
              "expect": {
                "status": 404,
                "type": "text/html",
                "contains": "Page not found"
              },
              "slowMs": 2000
            }
          ]
        },
        {
          "key": "https",
          "name": "HTTPS",
          "critical": false,
          "checks": [
            {
              "url": "http://dliu.com/",
              "method": "HEAD",
              "expect": {
                "status": 301,
                "location": "https://dliu.com/"
              },
              "slowMs": 2000
            }
          ]
        }
      ]
    },
    {
